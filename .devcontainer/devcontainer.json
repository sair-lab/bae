// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "pytorch 2503",
	"image": "nvcr.io/nvidia/pytorch:25.03-py3",

	"mounts": [
		"source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind",
		"source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind",
		"source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind",
		"source=${localEnv:HOME}/.ssh,target=/tmp/ssh-host,type=bind,readonly"
	],
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	"postCreateCommand": "curl -fsSL https://chatgpt.com/codex/install.sh | sh && curl -fsSL https://claude.ai/install.sh | bash && pip install nvidia-cudss-cu12==0.7.1.6 && python -m pip install --no-build-isolation -v -e .",
	"postStartCommand": "mkdir -p /root/.ssh && cp -r /tmp/ssh-host/* /root/.ssh/ 2>/dev/null || true; chmod 700 /root/.ssh; chmod 600 /root/.ssh/id_* 2>/dev/null || true; chmod 644 /root/.ssh/*.pub 2>/dev/null || true",

	// Configure tool-specific properties.
	// "customizations": {},

	"runArgs": ["--user=0:0", "--gpus", "all", "--shm-size=8g"],
	"remoteUser": "root"
}
